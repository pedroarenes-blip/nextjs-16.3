# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and will NEVER be committed.

# Database (NeonDB — PostgreSQL serverless)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Panel admin (/admin): bootstrap del primer admin (email+contraseña, tabla
# admins). Solo se usa si la tabla admins está vacía; después se autentica
# contra la BD. ADMIN_SECRET es opcional (firma de sesiones; por defecto usa
# ADMIN_PASSWORD).
ADMIN_PASSWORD="Temporal1234!"
ADMIN_SECRET=""

# Public site URL (used for SEO, sitemap, canonical)
NEXT_PUBLIC_SITE_URL="https://example.com"

# Google Analytics (Measurement ID, e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=""

# Analytics consent (set to "true" to enable GA by default without banner)
NEXT_PUBLIC_ANALYTICS_DEFAULT_CONSENT="false"

# OpenRouter — imágenes IA del CMS (editar/crear imágenes en /admin/imagenes y en
# los campos de imagen). Se puede poner también desde el CMS (Settings), que tiene
# prioridad sobre esta variable. https://openrouter.ai/settings/keys
OPENROUTER_API_KEY="sk-or-v1-..."

# Vercel Blob — almacenamiento de imágenes subidas desde el CMS.
# Crear un store: `npx vercel blob create-store` (o dashboard de Vercel) y pegar aquí
# el BLOB_READ_WRITE_TOKEN que devuelve.
BLOB_READ_WRITE_TOKEN=""

# ─────────────────────────────────────────────────────────────────────────────
# CMS de Squaads (@squaads/cms-*) — para páginas escritas EN CÓDIGO (/panel).
# Distinto del CMS del template (/admin, arriba), que gobierna las páginas de la
# base. Ver la nota de coexistencia en el README.
#
# TODAS estas variables son POR PROYECTO: cada proyecto tiene su propio par de
# claves (lo da el arquitecto al crear el proyecto en el servicio) y su propio
# usuario/contraseña de panel. Ninguna lleva prefijo NEXT_PUBLIC_: son de
# servidor y nunca llegan al navegador.
# ─────────────────────────────────────────────────────────────────────────────

# Origen del servicio del CMS.
CMS_SERVICE_URL="https://cms-squaads.vercel.app"
# Clave pública de lectura del proyecto (pub_...).
CMS_READ_KEY=""
# Clave de escritura del proyecto (sec_...). Nunca la expongas.
CMS_WRITE_KEY=""
# Secreto HMAC para validar el webhook de revalidación del proyecto.
CMS_WEBHOOK_SECRET=""

# Acceso al panel /panel. Sin AMBAS, el panel y su API quedan CERRADOS (503) —
# es el comportamiento seguro por defecto, no un fallo. La contraseña necesita
# 12+ caracteres; generala con `openssl rand -base64 24`.
CMS_AUTH_USER=""
CMS_AUTH_PASSWORD=""